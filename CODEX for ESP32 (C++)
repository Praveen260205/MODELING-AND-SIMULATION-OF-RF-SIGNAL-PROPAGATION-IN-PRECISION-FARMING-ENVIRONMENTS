// =====================================================
// READ SOIL MOISTURE
// =====================================================

void readSoilMoisture()
{

  soilRaw = analogRead(SOIL_SENSOR_PIN);

  waterLevel = map(
    soilRaw,
    DRY_VALUE,
    WET_VALUE,
    0,
    100
  );

  waterLevel = constrain(
    waterLevel,
    0,
    100
  );
}

// =====================================================
// READ SENSORS
// =====================================================

void readSensors()
{

  readSoilMoisture();

  /*
   * Many rain/fire/IR modules use
   * LOW = detected.
   *
   * If your module works opposite,
   * change LOW to HIGH.
   */

  rainDetected =
    digitalRead(RAIN_SENSOR_PIN) == LOW;

  fireDetected =
    digitalRead(FIRE_SENSOR_PIN) == LOW;

  animalDetected =
    digitalRead(IR_SENSOR_PIN) == LOW;
}

// =====================================================
// AUTOMATIC SYSTEM CONTROL
// =====================================================

void automaticControl()
{

  // ---------------------------------
  // LOW WATER
  // ---------------------------------

  if(waterLevel <= LOW_WATER_LEVEL)
  {
    pumpStatus = true;
  }
  else
  {
    pumpStatus = false;
  }


  // ---------------------------------
  // RAIN
  // ---------------------------------

  if(rainDetected)
  {
    coverStatus = true;
  }
  else
  {
    coverStatus = false;
  }


  // ---------------------------------
  // FIRE
  // ---------------------------------

  if(fireDetected)
  {
    fanStatus = true;
    pumpStatus = true;
  }
  else
  {
    fanStatus = false;
  }


  // ---------------------------------
  // ANIMAL
  // ---------------------------------

  if(animalDetected)
  {
    scaringStatus = true;
  }
  else
  {
    scaringStatus = false;
  }


  // ---------------------------------
  // WRITE OUTPUTS
  // ---------------------------------

  digitalWrite(
    WATER_PUMP_PIN,
    pumpStatus ? RELAY_ON : RELAY_OFF
  );

  digitalWrite(
    COVER_PIN,
    coverStatus ? RELAY_ON : RELAY_OFF
  );

  digitalWrite(
    COOLING_FAN_PIN,
    fanStatus ? RELAY_ON : RELAY_OFF
  );

  digitalWrite(
    SCARING_PIN,
    scaringStatus ? RELAY_ON : RELAY_OFF
  );
}

// =====================================================
// JSON DATA
// =====================================================

String getJSON()
{

  String json = "{";

  json += "\"water\":";
  json += waterLevel;
  json += ",";

  json += "\"rain\":";
  json += rainDetected ? "true" : "false";
  json += ",";

  json += "\"fire\":";
  json += fireDetected ? "true" : "false";
  json += ",";

  json += "\"animal\":";
  json += animalDetected ? "true" : "false";
  json += ",";

  json += "\"pump\":";
  json += pumpStatus ? "true" : "false";
  json += ",";

  json += "\"cover\":";
  json += coverStatus ? "true" : "false";
  json += ",";

  json += "\"fan\":";
  json += fanStatus ? "true" : "false";
  json += ",";

  json += "\"scare\":";
  json += scaringStatus ? "true" : "false";

  json += "}";

  return json;
}

// =====================================================
// WEB SERVER
// =====================================================

void handleRoot()
{
  server.send_P(
    200,
    "text/html",
    MAIN_page
  );
}

void handleData()
{

  readSensors();

  automaticControl();

  server.send(
    200,
    "application/json",
    getJSON()
  );
}

// =====================================================
// SETUP
// =====================================================

void setup()
{

  Serial.begin(115200);

  // Sensor pins

  pinMode(
    SOIL_SENSOR_PIN,
    INPUT
  );

  pinMode(
    RAIN_SENSOR_PIN,
    INPUT
  );

  pinMode(
    FIRE_SENSOR_PIN,
    INPUT
  );

  pinMode(
    IR_SENSOR_PIN,
    INPUT
  );


  // Output pins

  pinMode(
    WATER_PUMP_PIN,
    OUTPUT
  );

  pinMode(
    COVER_PIN,
    OUTPUT
  );

  pinMode(
    COOLING_FAN_PIN,
    OUTPUT
  );

  pinMode(
    SCARING_PIN,
    OUTPUT
  );


  // Initially OFF

  digitalWrite(
    WATER_PUMP_PIN,
    RELAY_OFF
  );

  digitalWrite(
    COVER_PIN,
    RELAY_OFF
  );

  digitalWrite(
    COOLING_FAN_PIN,
    RELAY_OFF
  );

  digitalWrite(
    SCARING_PIN,
    RELAY_OFF
  );


  // =================================================
  // CREATE ESP32 ACCESS POINT
  // =================================================

  WiFi.mode(WIFI_AP);

  WiFi.softAP(
    AP_SSID,
    AP_PASSWORD
  );


  Serial.println();
  Serial.println("==============================");
  Serial.println(" SMART FARM ESP32");
  Serial.println("==============================");

  Serial.print("Wi-Fi Name: ");
  Serial.println(AP_SSID);

  Serial.print("Password: ");
  Serial.println(AP_PASSWORD);

  Serial.print("Dashboard: ");
  Serial.println(
    WiFi.softAPIP()
  );


  // =================================================
  // WEB ROUTES
  // =================================================

  server.on(
    "/",
    handleRoot
  );

  server.on(
    "/data",
    handleData
  );

  server.begin();

  Serial.println(
    "Web server started!"
  );
}

// =====================================================
// LOOP
// =====================================================

void loop()
{

  server.handleClient();

}
